
{
  "expo": {
    "name": "Endless Drift",
    "slug": "endless-drift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dc22f172-90b2-459a-97d4-ea0468921bfe.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/dc22f172-90b2-459a-97d4-ea0468921bfe.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Natively",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/dc22f172-90b2-459a-97d4-ea0468921bfe.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Natively"
    },
    "web": {
      "favicon": "./assets/images/dc22f172-90b2-459a-97d4-ea0468921bfe.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser"
    ],
    "scheme": "endless-drift",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
